# Set to the URL people use to reach this instance. Enables absolute preview URLs.
# Put an HTTPS reverse proxy in front when exposing this on the internet.
PUBLIC_URL=
PORT=8080
BIND_ADDRESS=0.0.0.0
MAX_FILE_MB=250
MAX_STORAGE_MB=10240
MAX_DURATION_MINUTES=20
DOWNLOAD_TIMEOUT_SECONDS=900
YT_DLP_VERSION=2026.08.19
