# Set to the URL people use to reach this instance. Enables absolute preview URLs.
# Put an HTTPS reverse proxy in front when exposing this on the internet.
PUBLIC_URL=
# Authenticates /api/v1 integrations; the web UI remains public.
# Generate a strong token, for example: openssl rand -hex 32
API_TOKEN=
PORT=8080
BIND_ADDRESS=0.0.0.0
MAX_FILE_MB=250
MAX_STORAGE_MB=10240
MAX_DURATION_MINUTES=20
DOWNLOAD_TIMEOUT_SECONDS=900
YT_DLP_VERSION=2026.08.19

# Optional: use an existing Docker volume for stored videos.
# DATA_VOLUME=shareme-data
