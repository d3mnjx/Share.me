{
  "name": "share-to-checks",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "python3 tests/integration.py",
    "test:browser": "BROWSER_TESTS=1 python3 tests/integration.py",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check ."
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "prettier": "3.9.10"
  }
}
